<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hector_rviz_overlay</name>
  <version>1.0.0</version>
  <description>Provides an Overlay that can be used i.e. in a Display plugin to display additional information on top of the rivz RenderPanel.</description>

  <maintainer email="fabian@sim.tu-darmstadt.de">Stefan Fabian</maintainer>

  <license>GPLv3</license>
  <author email="fabian@sim.tu-darmstadt.de">Stefan Fabian</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <build_depend>qt6-base-dev</build_depend>
  <build_depend>qt6-declarative-dev</build_depend>
  <build_depend>libglew-dev</build_depend>
  <depend>libqt6-core</depend>
  <depend>libqt6-gui</depend>
  <depend>libqt6-opengl</depend>
  <depend>libqt6-qml</depend>
  <depend>libqt6-quick</depend>
  <depend>libqt6-widgets</depend>
  <depend>pluginlib</depend>
  <depend>rviz_common</depend>
  <depend>rviz_ogre_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
